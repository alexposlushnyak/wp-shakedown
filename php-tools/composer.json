{
  "name": "wp-shakedown/php-tools",
  "description": "PHP tools that wp-shakedown runs. Not a library.",
  "license": "GPL-2.0-or-later",
  "require": {
    "phpcompatibility/phpcompatibility-wp": "^3.0@alpha",
    "squizlabs/php_codesniffer": "^3.13",
    "wp-coding-standards/wpcs": "^3.4",
    "plugin-check/phpcs-sniffs": "2.2.0",
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "php-stubs/wordpress-stubs": "^7.0",
    "theme-check/theme-check": "20260901",
    "envato/envato-theme-check": "dev-master"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "minimum-stability": "alpha",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "package",
      "package": {
        "name": "plugin-check/phpcs-sniffs",
        "version": "2.2.0",
        "type": "phpcodesniffer-standard",
        "dist": {
          "url": "https://github.com/WordPress/plugin-check/archive/refs/tags/2.2.0.zip",
          "type": "zip"
        },
        "require": {
          "phpcsstandards/phpcsutils": "^1.0.8",
          "squizlabs/php_codesniffer": "^3.7.2"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "theme-check/theme-check",
        "version": "20260901",
        "type": "library",
        "dist": {
          "url": "https://downloads.wordpress.org/plugin/theme-check.20260901.zip",
          "type": "zip",
          "shasum": "85c13a0c70078367d2d6f3dd68e435212df5881a"
        }
      }
    },
    {
      "type": "package",
      "package": {
        "name": "envato/envato-theme-check",
        "version": "dev-master",
        "type": "library",
        "dist": {
          "url": "https://github.com/envato/envato-theme-check/archive/915562cc78065a69e65f27bc30993dcae4cacef6.zip",
          "type": "zip",
          "reference": "915562cc78065a69e65f27bc30993dcae4cacef6"
        }
      }
    }
  ]
}
