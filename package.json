{
  "name": "wp-shakedown",
  "version": "0.3.0",
  "description": "Runs the usual WordPress checks on a theme, a plugin or a whole WordPress folder and writes one report.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "bin": {
    "wp-shakedown": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "php-tools",
    "js-tools",
    "php-wasm",
    "ai-tools",
    "ui/dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run build:ui",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "build:ui": "npm --prefix ui run build",
    "build:core": "tsc -p tsconfig.build.json",
    "tools:check": "node scripts/tools-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexposlushnyak/wp-shakedown.git"
  },
  "bugs": "https://github.com/alexposlushnyak/wp-shakedown/issues",
  "author": "alexposlushnyak (https://github.com/alexposlushnyak)",
  "homepage": "https://github.com/alexposlushnyak/wp-shakedown#readme",
  "keywords": [
    "wordpress",
    "testing",
    "phpcs",
    "phpstan",
    "wp-cli",
    "mcp",
    "cli"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
